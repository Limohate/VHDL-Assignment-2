  <vhdl appearance="logisim_evolution" name="mux8_1">
library ieee;
use ieee.std_logic_1164.all;

entity mux8_1 is
    port(
        a, b, c, d : in std_logic;
        e, f, g, h : in std_logic;
        ch : in std_logic_vector(2 downto 0);
        data : out std_logic
    );
end entity mux8_1;

architecture bhv of mux8_1 is
begin
    process(a,b,c,d,e,f,g,h,ch)
    begin
        case ch is
            when "000" =&gt; data &lt;= a;
            when "001" =&gt; data &lt;= b;
            when "010" =&gt; data &lt;= c;
            when "011" =&gt; data &lt;= d;
            when "100" =&gt; data &lt;= e;
            when "101" =&gt; data &lt;= f;
            when "110" =&gt; data &lt;= g;
            when "111" =&gt; data &lt;= h;
            when others =&gt; data &lt;= '0';
        end case;
    end process;
end architecture bhv;
</vhdl>
